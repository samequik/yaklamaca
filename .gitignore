# Unity'nin ürettiği, yeniden üretilebilen klasörler.
# Library özellikle önemli: gigabaytlarca import önbelleği ve Unity onu
# Assets + ProjectSettings'ten kendisi kuruyor.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE'lerin ürettiği proje dosyaları — Unity her açılışta yeniden yazıyor.
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
.vs/
.vscode/
.idea/

# Build çıktıları
*.apk
*.aab
*.app
*.unitypackage
sysinfo.txt

# Kazara kök dizine düşmüş derleme çıktısı (Assets dışında, Unity görmüyor).
# Assets içindeki .dll'ler GEREKLİ, o yüzden *.dll diye genel bir kural YOK.
/AtmosphereSetup.dll

# unity-chan! paketi commit'e hiç girmiyor (kullanıcı talimatı). Şimdiye kadar
# bu yalnızca "asla git add etme" disiplinine dayanıyordu — hiçbir yerde
# gerçek bir kural yoktu, yani her `git add -A` ya da her şeyi otomatik
# sahneleyen bir arayüz (ör. bir Git GUI'nin "Create PR" düğmesi) onu
# sessizce commit'e sokabilirdi. 2026-09-14: bu araç kaydedildikten sonra
# fark edildi.
/Assets/unity-chan!/
/Assets/unity-chan!.meta
